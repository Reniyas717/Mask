# Project Specific (Do not upload large datasets or temporary training outputs)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Ignore training outputs, checkpoints, and logs
outputs/logs/*
!outputs/logs/.gitkeep
outputs/models/*
!outputs/models/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep

# Keep the final deployment models but ignore heavy temporary checkpoints
# If models/ is large (>100MB), you may need Git LFS.
# models/face_detector/*.caffemodel
# models/face_detector/*.prototxt
# If you want to track models, uncomment the next line. 
# Otherwise, keep it to avoid uploading huge .h5 files to github.
# models/*.h5
